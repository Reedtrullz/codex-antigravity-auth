{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Operational CLI result version 1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "command",
    "status",
    "ok",
    "exitCode",
    "warnings",
    "errors",
    "data"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "command": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "status": {
      "enum": [
        "ready",
        "degraded",
        "failed"
      ]
    },
    "ok": {
      "type": "boolean"
    },
    "exitCode": {
      "enum": [
        0,
        1,
        2,
        130
      ]
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "maxItems": 64
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "maxItems": 64
    },
    "data": {
      "type": [
        "object",
        "null"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "failed"
          }
        }
      },
      "then": {
        "properties": {
          "ok": {
            "const": false
          },
          "exitCode": {
            "enum": [
              1,
              2,
              130
            ]
          },
          "errors": {
            "minItems": 1
          }
        }
      },
      "else": {
        "properties": {
          "ok": {
            "const": true
          },
          "exitCode": {
            "const": 0
          },
          "errors": {
            "maxItems": 0
          }
        }
      }
    }
  ]
}
