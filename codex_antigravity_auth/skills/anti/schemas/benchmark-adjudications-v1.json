{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:anti:benchmark-adjudications-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "corpusSha256",
    "records"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "kind": {
      "const": "anti-benchmark-adjudications"
    },
    "corpusSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "records": {
      "type": "array",
      "maxItems": 8192,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "armId",
          "armIdentitySha256",
          "caseId",
          "findingId",
          "findingSha256",
          "sourceSha256",
          "verdict",
          "defectId",
          "reviewer",
          "evidence"
        ],
        "properties": {
          "armId": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,63}$"
          },
          "caseId": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,63}$"
          },
          "findingId": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,63}$"
          },
          "findingSha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "sourceSha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "verdict": {
            "enum": [
              "confirmed",
              "rejected",
              "unresolved"
            ]
          },
          "defectId": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,63}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "reviewer": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[^\\u0000-\\u001f\\ud800-\\udfff]+$"
          },
          "evidence": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "detail",
              "sha256",
              "independent"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "source_inspection",
                  "reproduction"
                ]
              },
              "detail": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000,
                "pattern": "^[^\\u0000-\\u001f\\ud800-\\udfff]+$"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "independent": {
                "const": true
              }
            }
          },
          "armIdentitySha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    }
  }
}
