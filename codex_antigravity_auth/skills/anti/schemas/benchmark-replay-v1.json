{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:anti:benchmark-replay-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "corpusSha256",
    "matchedSettings",
    "arms"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "kind": {
      "const": "anti-benchmark-replay"
    },
    "corpusSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "matchedSettings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "effort",
        "maxCalls",
        "maxInputEstimate",
        "maxOutputTokens"
      ],
      "properties": {
        "effort": {
          "enum": [
            "none",
            "minimal",
            "low",
            "medium",
            "high",
            "xhigh",
            "max"
          ]
        },
        "maxCalls": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "maxInputEstimate": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000000
        },
        "maxOutputTokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000000
        }
      }
    },
    "arms": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "model",
          "provider",
          "settings",
          "cases"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,63}$"
          },
          "model": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[^\\u0000-\\u001f\\ud800-\\udfff]+$"
          },
          "provider": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[^\\u0000-\\u001f\\ud800-\\udfff]+$"
          },
          "settings": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "effort",
              "maxCalls",
              "maxInputEstimate",
              "maxOutputTokens"
            ],
            "properties": {
              "effort": {
                "enum": [
                  "none",
                  "minimal",
                  "low",
                  "medium",
                  "high",
                  "xhigh",
                  "max"
                ]
              },
              "maxCalls": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100
              },
              "maxInputEstimate": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1000000000
              },
              "maxOutputTokens": {
                "type": "integer",
                "minimum": 1,
                "maximum": 10000000
              }
            }
          },
          "cases": {
            "type": "array",
            "maxItems": 32,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "caseId",
                "sourceSha256",
                "promptSha256",
                "scope",
                "scopeSha256",
                "status",
                "submittedCalls",
                "requestedOutputTokens",
                "latencyMs",
                "estimatedInputTokens",
                "observedInputTokens",
                "observedOutputTokens",
                "findings"
              ],
              "properties": {
                "caseId": {
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,63}$"
                },
                "sourceSha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "promptSha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "scope": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "files",
                    "complete",
                    "omittedFiles"
                  ],
                  "properties": {
                    "files": {
                      "type": "array",
                      "maxItems": 32,
                      "items": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128,
                        "pattern": "^[^\\u0000-\\u001f\\ud800-\\udfff]+$"
                      },
                      "uniqueItems": true
                    },
                    "complete": {
                      "type": "boolean"
                    },
                    "omittedFiles": {
                      "type": "array",
                      "maxItems": 32,
                      "items": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128,
                        "pattern": "^[^\\u0000-\\u001f\\ud800-\\udfff]+$"
                      },
                      "uniqueItems": true
                    }
                  }
                },
                "scopeSha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "status": {
                  "enum": [
                    "completed",
                    "failed",
                    "unavailable"
                  ]
                },
                "submittedCalls": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "requestedOutputTokens": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "latencyMs": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "estimatedInputTokens": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "observedInputTokens": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "observedOutputTokens": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "findings": {
                  "type": "array",
                  "maxItems": 32,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "id",
                      "file",
                      "line",
                      "claim",
                      "severity"
                    ],
                    "properties": {
                      "id": {
                        "type": "string",
                        "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,63}$"
                      },
                      "file": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128,
                        "pattern": "^[^\\u0000-\\u001f\\ud800-\\udfff]+$"
                      },
                      "line": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 100000
                      },
                      "claim": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2000,
                        "pattern": "^[^\\u0000-\\u001f\\ud800-\\udfff]+$"
                      },
                      "severity": {
                        "enum": [
                          "critical",
                          "high",
                          "medium",
                          "low",
                          "info"
                        ]
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "minItems": 1
    }
  }
}
