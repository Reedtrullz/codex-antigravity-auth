{
  "type": "object",
  "properties": {
    "schemaVersion": {
      "enum": [
        1
      ]
    },
    "kind": {
      "enum": [
        "anti-music-review"
      ]
    },
    "comparisonStatus": {
      "enum": [
        "consistent",
        "discrepancy",
        "uncertain",
        "not-compared"
      ]
    },
    "findings": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "properties": {
          "clipId": {
            "type": "string"
          },
          "startSeconds": {
            "type": "number",
            "minimum": 0,
            "maximum": 30
          },
          "endSeconds": {
            "type": "number",
            "minimum": 0,
            "maximum": 30
          },
          "description": {
            "type": "string"
          },
          "origin": {
            "enum": [
              "model-advisory"
            ]
          },
          "claimIds": {
            "type": "array",
            "maxItems": 64,
            "items": {
              "type": "string"
            }
          },
          "uncertainty": {
            "type": "string"
          }
        },
        "required": [
          "clipId",
          "startSeconds",
          "endSeconds",
          "description",
          "origin",
          "claimIds",
          "uncertainty"
        ],
        "additionalProperties": false
      }
    },
    "limitations": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "string"
      }
    },
    "musicalAcceptance": {
      "enum": [
        "not-established"
      ]
    }
  },
  "required": [
    "schemaVersion",
    "kind",
    "comparisonStatus",
    "findings",
    "limitations",
    "musicalAcceptance"
  ],
  "additionalProperties": false
}
